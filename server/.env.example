PORT=3000

# OpenAI-compatible chat-completions endpoint (base URL, no trailing slash).
MISTRAL_BASE_URL=https://mistral.cndrbrbr.de/v1
MISTRAL_MODEL=mistral

# CORS origin allowed to call this proxy from the browser. Use the exact
# origin the app is hosted on (e.g. https://cndrbrbr.github.io) once known;
# "*" works for local testing.
ALLOWED_ORIGIN=*
